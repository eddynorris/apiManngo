# Plantilla de variables. NO poner valores reales aquí.
# app.py carga `.env` (o `.env.production` si FLASK_ENV=production). En Railway las variables
# se definen en el panel del servicio.

# --- Flask ---
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
# Producción (Dockerfile): gunicorn usa estas dos
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Base de datos ---
# Desarrollo (SQLite): sqlite:///manngo_dev.db
# Desarrollo (Postgres local): postgresql://postgres:password@localhost:5432/manngo_db
DATABASE_URL=postgresql://user:password@host:5432/manngo_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# --- Seguridad ---
# Mínimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-at-least-32-chars-long
JWT_EXPIRES_SECONDS=43200
# Orígenes permitidos separados por comas (sin comodín en producción)
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting (Flask-Limiter) ---
# En producción es OBLIGATORIO un Redis (redis:// o rediss://); memory:// se rechaza al arrancar.
# Railway: LIMITER_STORAGE_URI=${{Redis.REDIS_URL}}
LIMITER_STORAGE_URI=memory://
DEFAULT_RATE_LIMIT=200 per day;50 per hour

# --- Archivos y logs ---
MAX_CONTENT_LENGTH=52428800
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Supabase (Storage de comprobantes/fotos y RAG del chat) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# --- Legado S3: app.py aún lee estas dos para un aviso de arranque; boto3 ya no se usa ---
S3_BUCKET=
AWS_REGION=

# --- Gemini ---
GOOGLE_API_KEY=your-google-api-key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
# Cabecera X-Telegram-Bot-Api-Secret-Token
TELEGRAM_BOT_SECRET_TOKEN=generate-a-strong-bot-secret-token-at-least-32-chars
# Segmento de ruta: /telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_WEBHOOK_SECRET=generate-a-unique-webhook-route-token

# --- SUNAT (Guía de Remisión Electrónica) ---
# El envío está deshabilitado salvo SUNAT_ENVIO_HABILITADO=true. Emitir en producción tiene efecto legal.
SUNAT_AMBIENTE=local
SUNAT_ENVIO_HABILITADO=false
SUNAT_RUC=
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
# Credenciales OAuth2 de la API GRE (client_id / client_secret)
MANNGO_ID_SUNAT=
MANNGO_CLAVE_SUNAT=
# Emisor de la guía (sin valores por defecto: si faltan, la guía no se emite y el bot dice qué falta)
SUNAT_RAZON_SOCIAL=
SUNAT_EMISOR_DIRECCION=
SUNAT_EMISOR_UBIGEO=
# Serie GRE del sistema propio: T + 3 caracteres (p. ej. T001); distinta de la EG07 del portal SOL
SUNAT_SERIE_GRE=
# Certificado digital (.p12/.pfx) en base64 y su clave. Cargarlos con entrada oculta, nunca por chat.
SUNAT_CERT_P12_B64=
SUNAT_CERT_PASSWORD=
# Vehículos, conductores, ubigeos y destinatarios de guía se guardan en la BD (no aquí).
