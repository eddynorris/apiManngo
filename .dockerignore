# VCS y metadatos del repositorio
.git
.gitignore
.github/
.gitattributes

# Entornos reales: NUNCA deben entrar al contexto de build.
.env
.env.*
**/.env
**/.env.*
# La plantilla sin valores privados sí puede quedar disponible.
!.env.example

# Entornos virtuales y artefactos de Python
venv/
.venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# Dumps, respaldos y datos privados
*.sql
# Las migraciones SQL versionadas sí se incluyen para revisión (no se ejecutan).
!migrations/**/*.sql
*.dump
*.backup
*.bak
*.sql.gz
*.sql.bz2
*.sql.xz
database/
backups/
legacy_migrations/
tests/
test.md

# Certificados, claves y secretos
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
certs/
certificates/
secrets/
.ssh/

# Herramientas de agentes, planes y artefactos locales
.hermes/
.archify/
.claude/
.agents/
.cursor/
.trae/
.kombai/
.vercel/
.playwright/

# Logs, temporales y cargas locales
*.log
logs/
tmp/
uploads/
*.tmp
*.swp
*~

# Sistema operativo / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Documentación y configuración de despliegue no necesaria en la imagen
docs/
README.md
CHANGELOG.md
*.md
Dockerfile
Dockerfile.*
docker-compose*.yml
docker-compose*.yaml
.dockerignore
